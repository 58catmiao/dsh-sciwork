  "description": "DSH 科研模式：给 DeepSeek Harness 装一套科研工作台——「科研模式」agent 预设 + 本机实体科研库（Python 引擎与登记索引）+ 12 份期刊投稿档案 + 投稿闸门（期刊合规体检 / 投稿包导出 / 递归全文索引）+ 绘图/写作/文献/期刊技能 + 只读为主的「科研库」面板。出图由智能体经上游 dsh-origin-plugin（Origin MCP）完成。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "research",
    "science",
    "scientific-writing",
    "origin",
    "科研"
  ],
  "license": "MIT",
  "author": "58catmiao",
  "homepage": "https://github.com/58catmiao/dsh-sciwork#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/58catmiao/dsh-sciwork.git"
  },
  "bugs": {
    "url": "https://github.com/58catmiao/dsh-sciwork/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "library",
    "skills",
    "scripts",
    "docs",
